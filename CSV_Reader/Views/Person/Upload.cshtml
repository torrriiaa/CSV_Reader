@{
    ViewData["Title"] = "Uploading CSV-file";
}

<h2>File Uploading</h2>

<div class="container border-3">
    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="mb-3">
        <div class="form-group mb-3" >
            <label for="file">Choose CSV-file:</label>
            <input type="file" name="file" id="file" class="form-control" accept=".csv" required lang="en" />
        </div>
        <button type="submit" class="btn btn-primary col-3">Upload</button>
    </form>
    <div>
        <a asp-action="Index" class="btn btn-outline-primary col-3 mb-3">Back to list</a>
    </div>
</div>


<div class="mt-4">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">@TempData["Message"]</div>
    }
</div>




